# Kopyalayın: cp .env.example .env.local  (gizli değerler yalnızca sunucuda tutulur)

# demo: uydurma kayıtlar, kalıcı değil | yerel: gerçek taranan kayıtlar, DATA_FILE dosyasında
DATA_MODE=yerel
DATA_FILE=.data/yerel.json

# Uygulamanın adresi (takvim etkinliğindeki CRM bağlantısı için)
APP_URL=http://localhost:3000

# gosom/google-maps-scraper ikili dosyası (yerel test). Sunucuda Docker container kullanılacak.
GMAPS_SCRAPER_BIN=/tam/yol/.data/bin/google-maps-scraper
GMAPS_SCRAPER_WORKDIR=.data/scraper

# Google Takvim: servis hesabı JSON anahtarının yolu ve yazılacak takvim (Gmail adresiniz)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=.secrets/google-service-account.json
GOOGLE_CALENDAR_ID=ornek@gmail.com

# ntfy bildirimleri (sunucu aşaması)
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
