# Yerel geliştirme: cp .env.example .env.local
# Boş bırakılırsa uygulama tarayıcıda DEMO modunda çalışır.

# Supabase (yayımlanabilir anahtar; gizli değil, RLS korur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub Pages özel alan adı yoksa: /cuswin-crm
NEXT_PUBLIC_BASE_PATH=

# --- Zamanlanmış işler (yalnızca GitHub Actions / yerel test; tarayıcıya gitmez) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
APP_URL=https://doktor.toso.tr
# Docker imajı (Actions) veya yerel ikili dosya
GMAPS_SCRAPER_IMAGE=gosom/google-maps-scraper:v1.18.1
GMAPS_SCRAPER_BIN=
GMAPS_SCRAPER_WORKDIR=.data/scraper
NTFY_TOPIC=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
